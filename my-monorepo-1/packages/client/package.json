{
    "name": "@my/client",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "./src/isomorphic.ts",
    "types": "./src/isomorphic.ts",
    "imports": {
        "#client/*": "./src/*.ts"
    },
    "exports": {
        ".": {
            "types": "./src/isomorphic.ts",
            "default": "./src/isomorphic.ts"
        },
        "./browser": {
            "types": "./src/browser.ts",
            "default": "./src/browser.ts"
        },
        "./browser/external": {
            "types": "./src/browser.external.ts",
            "default": "./src/browser.external.ts"
        },
        "./server": {
            "types": "./src/server.ts",
            "default": "./src/server.ts"
        },
        "./server/external": {
            "types": "./src/server.external.ts",
            "default": "./src/server.external.ts"
        }
    },
    "scripts": {
        "lint": "eslint",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@my/env": "*",
        "@my/error": "*",
        "@my/logger": "*",
        "axios": "^1.21.0",
        "client-only": "^0.0.1",
        "server-only": "^0.0.1"
    },
    "devDependencies": {
        "type-fest": "^5.10.0"
    }
}
