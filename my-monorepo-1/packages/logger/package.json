{
    "name": "@my/logger",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "./src/isomorphic.ts",
    "types": "./src/isomorphic.ts",
    "imports": {
        "#logger/*": "./src/*.ts"
    },
    "exports": {
        ".": {
            "types": "./src/isomorphic.ts",
            "default": "./src/isomorphic.ts"
        },
        "./server": {
            "types": "./src/server.ts",
            "default": "./src/server.ts"
        },
        "./browser": {
            "types": "./src/browser.ts",
            "default": "./src/browser.ts"
        }
    },
    "scripts": {
        "lint": "eslint",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@my/env": "*",
        "client-only": "^0.0.1",
        "server-only": "^0.0.1",
        "source-map-support": "^0.5.21",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/source-map-support": "^0.5.10"
    }
}
